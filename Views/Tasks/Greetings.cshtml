@{
    ViewData["Title"] = "Greetings";

    var myMessage = "Hello C# Marathon!";
    var greeting = "Welcome to our project!";
    var currentTime = DateTime.Now;
    string timeGreeting;

    if (currentTime.Hour < 12)
    {
        timeGreeting = "Good Morning!";
    }
    else
    {
        timeGreeting = "Good Evening!";
    }
}

<h1>Greetings</h1>

<p>The value of myMessage is: @myMessage</p>
<p>The greeting is: @greeting</p>
<p>Here in Ukraine: @currentTime.DayOfWeek</p>
<p>We wish you: @timeGreeting</p>
<p>Today is @currentTime.DayOfWeek</p>

<table class="table table-bordered date-time-table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Value</th>
    </tr>
    </thead>
    <tbody>
    <tr><td>Day</td><td>@currentTime.Day</td></tr>
    <tr><td>Hour</td><td>@currentTime.Hour</td></tr>
    <tr><td>Minute</td><td>@currentTime.Minute</td></tr>
    <tr><td>Second</td><td>@currentTime.Second</td></tr>
    </tbody>
</table>
